rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Règle pour la collection budgetData
    // Permet à tous les utilisateurs authentifiés de partager les mêmes données
    // Parfait pour un budget familial entre Mathieu et Assia
    match /budgetData/{accountId}/months/{month} {
      // Autorise la lecture et l'écriture uniquement si l'utilisateur est authentifié
      allow read, write: if request.auth != null;
    }

    // Règle par défaut : interdire tout accès non autorisé
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
